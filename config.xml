<?xml version='1.0' encoding='utf-8'?>
<widget id="it.previtali.medtranslator" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:android="http://schemas.android.com/apk/res/android">
    <name>MedTranslator</name>
    <description>Frasi pronte per parlare con i pazienti stranieri: infermieri, OSS, OA e medici. 12 lingue, a voce e a schermo.</description>
    <author>Massimiliano Previtali</author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="mailto:*" />
    <!-- Solo verticale: il traduttore si usa col telefono in mano, girato verso il paziente. -->
    <preference name="Orientation" value="portrait" />
    <preference name="DisallowOverscroll" value="true" />
    <preference name="AndroidWindowSplashScreenBackground" value="#ffffff" />
    <platform name="android">
        <allow-intent href="market:*" />
    </platform>
</widget>
